{
  "manifest_version": 1,
  "type": "device",
  "name": "Proxmox Backup Server",
  "description": {
    "en": "Read-only monitoring of Proxmox Backup Server datastores and maintenance tasks.",
    "fr": "Supervision en lecture seule des datastores et tâches de maintenance Proxmox Backup Server.",
    "de": "Schreibgeschützte Überwachung der Datastores und Wartungsaufgaben von Proxmox Backup Server.",
    "es": "Supervisión de solo lectura de los datastores y tareas de mantenimiento de Proxmox Backup Server."
  },
  "version": "2.5.1",
  "docker_image": "ghcr.io/prohand/gladys-proxmox-backup-server:2.5.1",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/prohand/gladys-proxmox-backup-server/main/cover.png",
  "categories": ["services", "network"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Proxmox Backup Server connection",
        "fr": "Connexion à Proxmox Backup Server",
        "de": "Verbindung zu Proxmox Backup Server",
        "es": "Conexión con Proxmox Backup Server"
      },
      "description": {
        "en": "Create a dedicated API token with the read-only DatastoreAudit and Audit roles. See the documentation for the exact commands.",
        "fr": "Créez un jeton API dédié avec les rôles de lecture seule DatastoreAudit et Audit. Consultez la documentation pour les commandes exactes.",
        "de": "Erstellen Sie ein eigenes API-Token mit den schreibgeschützten Rollen DatastoreAudit und Audit. Die genauen Befehle finden Sie in der Dokumentation.",
        "es": "Cree un token de API dedicado con los roles de solo lectura DatastoreAudit y Audit. Consulte la documentación para ver los comandos exactos."
      },
      "links": [
        {
          "url": "https://pbs.proxmox.com/docs/user-management.html",
          "label": {
            "en": "PBS permissions documentation",
            "fr": "Documentation des permissions PBS",
            "de": "Dokumentation der PBS-Berechtigungen",
            "es": "Documentación de permisos de PBS"
          }
        }
      ]
    },
    {
      "key": "base_url",
      "type": "string",
      "label": {
        "en": "Server URL",
        "fr": "URL du serveur",
        "de": "Server-URL",
        "es": "URL del servidor"
      },
      "description": {
        "en": "For example: https://pbs.example.com:8007. Avoid http://: it sends the API token in clear text.",
        "fr": "Par exemple : https://pbs.example.com:8007. Évitez http:// : le jeton API circule alors en clair.",
        "de": "Zum Beispiel: https://pbs.example.com:8007. Vermeiden Sie http://: Das API-Token wird dann im Klartext übertragen.",
        "es": "Por ejemplo: https://pbs.example.com:8007. Evite http://: el token de API viaja entonces sin cifrar."
      },
      "required": true
    },
    {
      "key": "api_token_id",
      "type": "string",
      "label": {
        "en": "API token ID",
        "fr": "Identifiant du jeton API",
        "de": "API-Token-ID",
        "es": "ID del token de API"
      },
      "description": {
        "en": "Full ID, for example gladys@pbs!monitoring",
        "fr": "Identifiant complet, par exemple gladys@pbs!monitoring",
        "de": "Vollständige ID, zum Beispiel gladys@pbs!monitoring",
        "es": "ID completo, por ejemplo gladys@pbs!monitoring"
      },
      "required": true
    },
    {
      "key": "api_token_secret",
      "type": "secret",
      "label": {
        "en": "API token secret",
        "fr": "Secret du jeton API",
        "de": "API-Token-Secret",
        "es": "Secreto del token de API"
      },
      "required": true
    },
    {
      "key": "node",
      "type": "string",
      "label": {
        "en": "PBS node name",
        "fr": "Nom du nœud PBS",
        "de": "Name des PBS-Knotens",
        "es": "Nombre del nodo PBS"
      },
      "required": false,
      "default": "localhost"
    },
    {
      "key": "poll_frequency",
      "type": "number",
      "label": {
        "en": "Refresh interval (seconds)",
        "fr": "Intervalle de rafraîchissement (secondes)",
        "de": "Aktualisierungsintervall (Sekunden)",
        "es": "Intervalo de actualización (segundos)"
      },
      "required": false,
      "default": 900,
      "min": 300,
      "max": 86400
    },
    {
      "key": "tls_fingerprint",
      "type": "string",
      "label": {
        "en": "TLS certificate fingerprint",
        "fr": "Empreinte du certificat TLS",
        "de": "Fingerabdruck des TLS-Zertifikats",
        "es": "Huella del certificado TLS"
      },
      "description": {
        "en": "Recommended with the default self-signed PBS certificate: its SHA-256 fingerprint (Dashboard > Show Fingerprint). The token is only sent to a server presenting it. Leave empty for a certificate signed by a trusted CA.",
        "fr": "Recommandé avec le certificat auto-signé de PBS : son empreinte SHA-256 (Tableau de bord > Afficher l'empreinte). Le jeton n'est envoyé qu'à un serveur qui la présente. Laissez vide pour un certificat signé par une AC reconnue.",
        "de": "Empfohlen mit dem selbstsignierten Standardzertifikat von PBS: sein SHA-256-Fingerabdruck (Dashboard > Show Fingerprint). Das Token wird nur an einen Server gesendet, der ihn vorweist. Leer lassen bei einem von einer vertrauenswürdigen CA signierten Zertifikat.",
        "es": "Recomendado con el certificado autofirmado predeterminado de PBS: su huella SHA-256 (Dashboard > Show Fingerprint). El token solo se envía a un servidor que la presente. Déjelo vacío con un certificado firmado por una CA de confianza."
      },
      "placeholder": {
        "en": "AA:BB:CC:...:FF",
        "fr": "AA:BB:CC:...:FF",
        "de": "AA:BB:CC:...:FF",
        "es": "AA:BB:CC:...:FF"
      },
      "required": false
    },
    {
      "key": "verify_tls",
      "type": "boolean",
      "label": {
        "en": "Verify TLS certificate",
        "fr": "Vérifier le certificat TLS",
        "de": "TLS-Zertifikat prüfen",
        "es": "Verificar el certificado TLS"
      },
      "required": false,
      "default": true,
      "description": {
        "en": "Ignored when a fingerprint is pinned. Turn off only as a last resort, on a trusted network: the connection stays encrypted but nothing proves the server is the real one.",
        "fr": "Ignoré quand une empreinte est épinglée. À désactiver en dernier recours, sur un réseau de confiance : la connexion reste chiffrée mais rien ne prouve l'identité du serveur.",
        "de": "Wird ignoriert, wenn ein Fingerabdruck hinterlegt ist. Nur als letzten Ausweg und in einem vertrauenswürdigen Netzwerk deaktivieren: Die Verbindung bleibt verschlüsselt, aber nichts beweist die Echtheit des Servers.",
        "es": "Se ignora cuando hay una huella fijada. Desactívelo solo como último recurso, en una red de confianza: la conexión sigue cifrada, pero nada garantiza que el servidor sea el auténtico."
      }
    },
    {
      "key": "date_format",
      "type": "select",
      "label": {
        "en": "Date format",
        "fr": "Format de date",
        "de": "Datumsformat",
        "es": "Formato de fecha"
      },
      "description": {
        "en": "Select how task dates are displayed, in the time zone set below.",
        "fr": "Sélectionnez le format d'affichage des dates des tâches, dans le fuseau horaire indiqué ci-dessous.",
        "de": "Wählen Sie, wie die Daten der Aufgaben angezeigt werden, in der unten festgelegten Zeitzone.",
        "es": "Seleccione cómo se muestran las fechas de las tareas, en la zona horaria indicada abajo."
      },
      "display": "dropdown",
      "options": [
        {
          "value": "iso",
          "label": {
            "en": "ISO 8601 — 2026-08-17T18:30:00.000Z",
            "fr": "ISO 8601 — 2026-08-17T18:30:00.000Z",
            "de": "ISO 8601 — 2026-08-17T18:30:00.000Z",
            "es": "ISO 8601 — 2026-08-17T18:30:00.000Z"
          }
        },
        {
          "value": "DD/MM/YYYY HH:mm:ss",
          "label": {
            "en": "Day/month/year — 17/08/2026 18:30:00",
            "fr": "Jour/mois/année — 17/08/2026 18:30:00",
            "de": "Tag/Monat/Jahr — 17/08/2026 18:30:00",
            "es": "Día/mes/año — 17/08/2026 18:30:00"
          }
        },
        {
          "value": "YYYY-MM-DD HH:mm:ss",
          "label": {
            "en": "Year-month-day — 2026-08-17 18:30:00",
            "fr": "Année-mois-jour — 2026-08-17 18:30:00",
            "de": "Jahr-Monat-Tag — 2026-08-17 18:30:00",
            "es": "Año-mes-día — 2026-08-17 18:30:00"
          }
        },
        {
          "value": "MM/DD/YYYY HH:mm:ss",
          "label": {
            "en": "Month/day/year — 08/17/2026 18:30:00",
            "fr": "Mois/jour/année — 08/17/2026 18:30:00",
            "de": "Monat/Tag/Jahr — 08/17/2026 18:30:00",
            "es": "Mes/día/año — 08/17/2026 18:30:00"
          }
        }
      ],
      "required": false,
      "default": "iso"
    },
    {
      "key": "timezone",
      "type": "string",
      "label": {
        "en": "Time zone",
        "fr": "Fuseau horaire",
        "de": "Zeitzone",
        "es": "Zona horaria"
      },
      "description": {
        "en": "IANA name used to display dates, for example Europe/Paris. Empty or unknown: UTC.",
        "fr": "Nom IANA utilisé pour afficher les dates, par exemple Europe/Paris. Vide ou inconnu : UTC.",
        "de": "IANA-Name für die Anzeige der Daten, zum Beispiel Europe/Paris. Leer oder unbekannt: UTC.",
        "es": "Nombre IANA usado para mostrar las fechas, por ejemplo Europe/Paris. Vacío o desconocido: UTC."
      },
      "required": false,
      "default": "UTC"
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "timeout_seconds": 30
    }
  ],
  "widgets": [
    {
      "key": "datastore",
      "label": {
        "en": "PBS datastore",
        "fr": "Datastore PBS",
        "de": "PBS-Datastore",
        "es": "Datastore PBS"
      },
      "description": {
        "en": "Usage, snapshots and maintenance tasks of one datastore.",
        "fr": "Occupation, snapshots et tâches de maintenance d'un datastore.",
        "de": "Belegung, Snapshots und Wartungsaufgaben eines Datastores.",
        "es": "Ocupación, snapshots y tareas de mantenimiento de un datastore."
      },
      "icon": "hard-drive",
      "settings": [
        {
          "key": "datastore",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Datastore",
            "fr": "Datastore",
            "de": "Datastore",
            "es": "Datastore"
          },
          "required": true
        },
        {
          "key": "show_tiles",
          "type": "boolean",
          "label": {
            "en": "Show usage, free space and snapshot tiles",
            "fr": "Afficher les tuiles utilisation, espace libre et snapshots",
            "de": "Kacheln für Belegung, freien Speicher und Snapshots anzeigen",
            "es": "Mostrar los mosaicos de uso, espacio libre y snapshots"
          },
          "required": false,
          "default": true
        }
      ],
      "action_timeout_seconds": 60
    },
    {
      "key": "overview",
      "label": {
        "en": "PBS backups",
        "fr": "Sauvegardes PBS",
        "de": "PBS-Sicherungen",
        "es": "Copias de seguridad PBS"
